generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model calendar_context {
  date       DateTime  @id @db.Date
  is_weekend Boolean
  is_holiday Boolean   @default(false)
  festival   String?
  season     String?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model driver_vehicle {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driver_id     String    @db.Uuid
  vehicle_id    String    @db.Uuid
  assigned_from DateTime  @default(now()) @db.Timestamptz(6)
  assigned_to   DateTime? @db.Timestamptz(6)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  drivers       drivers   @relation(fields: [driver_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vehicles      vehicles  @relation(fields: [vehicle_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([driver_id, vehicle_id], map: "idx_driver_vehicle_dv")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model drivers {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String            @unique @db.Uuid
  owner_id        String            @db.Uuid
  contact         String?
  license_number  String?
  license_expiry  DateTime?         @db.Date
  dob             DateTime?         @db.Date
  joining_date    DateTime?         @default(dbgenerated("CURRENT_DATE")) @db.Date
  salary          Decimal?          @db.Decimal(12, 2)
  status          user_status       @default(active)
  documents       Json?             @default("[]")
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  driver_vehicle  driver_vehicle[]
  owners          owners            @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  geofence_alerts geofence_alerts[]
  ml_predictions  ml_predictions[]
  trips           trips[]

  @@index([owner_id], map: "idx_drivers_owner_id")
  @@index([user_id], map: "idx_drivers_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model expenses {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicle_id  String       @db.Uuid
  trip_id     String?      @db.Uuid
  type        expense_type
  amount      Decimal      @db.Decimal
  description String?
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  updated_at  DateTime     @default(now()) @db.Timestamptz(6)
  trips       trips?       @relation(fields: [trip_id], references: [id], onUpdate: NoAction)
  vehicles    vehicles     @relation(fields: [vehicle_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model fuel_logs {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicle_id      String   @db.Uuid
  trip_id         String?  @db.Uuid
  liters          Decimal  @db.Decimal(10, 2)
  price_per_liter Decimal? @db.Decimal(10, 2)
  cost            Decimal? @db.Decimal(12, 2)
  odometer        Decimal? @db.Decimal(12, 2)
  fuel_station    String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  trips           trips?   @relation(fields: [trip_id], references: [id], onUpdate: NoAction)
  vehicles        vehicles @relation(fields: [vehicle_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([trip_id], map: "idx_fuel_logs_trip_id")
  @@index([vehicle_id], map: "idx_fuel_logs_vehicle_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model geofence_alerts {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trip_id     String?    @db.Uuid
  driver_id   String?    @db.Uuid
  vehicle_id  String?    @db.Uuid
  geofence_id String     @db.Uuid
  alert_type  alert_type
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  mail_sent   Boolean    @default(false)
  drivers     drivers?   @relation(fields: [driver_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  geofences   geofences  @relation(fields: [geofence_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  trips       trips?     @relation(fields: [trip_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vehicles    vehicles?  @relation(fields: [vehicle_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([trip_id], map: "idx_geofence_alerts_trip")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model geofences {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id        String            @db.Uuid
  name            String
  polygon         Json?
  radius          Decimal?          @db.Decimal(10, 2)
  alert_email     String?
  is_active       Boolean           @default(true)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  geofence_alerts geofence_alerts[]
  owners          owners            @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([owner_id], map: "idx_geofences_owner_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model gps_logs {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trip_id     String   @db.Uuid
  latitude    Float
  longitude   Float
  speed       Decimal? @db.Decimal(7, 2)
  heading     Decimal? @db.Decimal(5, 2)
  accuracy    Decimal? @db.Decimal(7, 2)
  recorded_at DateTime @default(now()) @db.Timestamptz(6)
  trips       trips    @relation(fields: [trip_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([recorded_at], map: "idx_gps_logs_recorded")
  @@index([trip_id], map: "idx_gps_logs_trip_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model maintenance {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicle_id     String    @db.Uuid
  service_date   DateTime  @db.Date
  next_service   DateTime? @db.Date
  cost           Decimal?  @db.Decimal(12, 2)
  remarks        String?
  service_center String?
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @db.Timestamptz(6)
  vehicles       vehicles  @relation(fields: [vehicle_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([vehicle_id], map: "idx_maintenance_vid")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ml_predictions {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trip_id        String?       @db.Uuid
  vehicle_id     String?       @db.Uuid
  driver_id      String?       @db.Uuid
  model_type     ml_model_type
  score          Decimal?      @db.Decimal(5, 4)
  recommendation String?
  generated_at   DateTime      @default(now()) @db.Timestamptz(6)
  drivers        drivers?      @relation(fields: [driver_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  trips          trips?        @relation(fields: [trip_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vehicles       vehicles?     @relation(fields: [vehicle_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([driver_id], map: "idx_ml_predictions_did")
  @@index([vehicle_id], map: "idx_ml_predictions_vid")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model notifications {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String       @db.Uuid
  title      String
  message    String?
  type       notif_type   @default(SYSTEM)
  status     notif_status @default(pending)
  sent_at    DateTime?    @db.Timestamptz(6)
  created_at DateTime     @default(now()) @db.Timestamptz(6)
  updated_at DateTime     @default(now()) @db.Timestamptz(6)
  users      users        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_notifications_uid")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model owners {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String      @unique @db.Uuid
  company_name String
  address      String?
  city         String?
  state        String?
  country      String?
  created_at   DateTime    @default(now()) @db.Timestamptz(6)
  updated_at   DateTime    @default(now()) @db.Timestamptz(6)
  drivers      drivers[]
  geofences    geofences[]
  users        users       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reports      reports[]
  vehicles     vehicles[]

  @@index([user_id], map: "idx_owners_user_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model reports {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id     String      @db.Uuid
  report_type  report_type
  start_date   DateTime?   @db.Date
  end_date     DateTime?   @db.Date
  generated_at DateTime    @default(now()) @db.Timestamptz(6)
  generated_by String?     @db.Uuid
  created_at   DateTime    @default(now()) @db.Timestamptz(6)
  updated_at   DateTime    @default(now()) @db.Timestamptz(6)
  users        users?      @relation(fields: [generated_by], references: [id], onUpdate: NoAction)
  owners       owners      @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([owner_id], map: "idx_reports_owner_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model trips {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driver_id       String                   @db.Uuid
  vehicle_id      String                   @db.Uuid
  start_time      DateTime?                @db.Timestamptz(6)
  end_time        DateTime?                @db.Timestamptz(6)
  start_lat       Float?
  start_lng       Float?
  end_lat         Float?
  end_lng         Float?
  distance        Decimal?                 @db.Decimal(10, 2)
  duration        Unsupported("interval")?
  weight_of_goods Decimal?                 @db.Decimal(10, 2)
  status          trip_status              @default(DRAFT)
  avg_speed       Decimal?                 @db.Decimal(7, 2)
  created_at      DateTime                 @default(now()) @db.Timestamptz(6)
  expenses        expenses[]
  fuel_logs       fuel_logs[]
  geofence_alerts geofence_alerts[]
  gps_logs        gps_logs[]
  ml_predictions  ml_predictions[]
  drivers         drivers                  @relation(fields: [driver_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vehicles        vehicles                 @relation(fields: [vehicle_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([driver_id], map: "idx_trips_driver_id")
  @@index([status], map: "idx_trips_status")
  @@index([vehicle_id], map: "idx_trips_vehicle_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  email         String          @unique
  password_hash String
  phone         String?
  role          user_role       @default(OWNER)
  status        user_status     @default(active)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @default(now()) @db.Timestamptz(6)
  drivers       drivers?
  notifications notifications[]
  owners        owners?
  reports       reports[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model vehicles {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id            String            @db.Uuid
  registration_number String            @unique
  vehicle_type        String?
  brand               String?
  model               String?
  purchase_date       DateTime?         @db.Date
  fuel_type           String?
  tank_capacity       Decimal?          @db.Decimal(10, 2)
  estimated_mileage   Decimal?          @db.Decimal(10, 2)
  documents           Json?             @default("[]")
  status              String            @default("available")
  created_at          DateTime          @default(now()) @db.Timestamptz(6)
  updated_at          DateTime          @default(now()) @db.Timestamptz(6)
  driver_vehicle      driver_vehicle[]
  expenses            expenses[]
  fuel_logs           fuel_logs[]
  geofence_alerts     geofence_alerts[]
  maintenance         maintenance[]
  ml_predictions      ml_predictions[]
  trips               trips[]
  owners              owners            @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([owner_id], map: "idx_vehicles_owner_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model weather_context {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date        DateTime  @db.Date
  city        String
  weather     String
  temperature Decimal?  @db.Decimal
  rainfall_mm Decimal?  @db.Decimal
  created_at  DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([date, city])
}

enum alert_type {
  ENTER
  EXIT
}

enum expense_type {
  FUEL
  TOLL
  PARKING
  MAINTENANCE
  OTHER
}

enum ml_model_type {
  FUEL
  FRAUD
  UTILIZATION
  DEMAND
  MAINTENANCE
}

enum notif_status {
  pending
  sent
  failed
}

enum notif_type {
  EMAIL
  SYSTEM
}

enum report_type {
  TRIP
  FUEL
  MAINTENANCE
  DRIVER
  VEHICLE
}

enum trip_status {
  DRAFT
  DISPATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum user_role {
  SUPER_ADMIN
  OWNER
  DRIVER
}

enum user_status {
  active
  inactive
  suspended
}
